@page
@model Mushroom_Finder.Pages.IdentifierModel
@{
    ViewData["Title"] = "Mushroom Identifier";
}

<div class="identifier-page">
    <header class="identifier-intro">
        <h1>Mushroom Identifier</h1>
        <p>Describe the characteristics you see to narrow down a possible mushroom identification.</p>
    </header>

    <div class="identifier-layout">
        <section class="identifier-form-card">
            <form>
                <h2 class="identifier-form-title">Describe What You See</h2>

                <h3 class="identifier-section-title">Color</h3>
                <details class="identifier-options">
                    <summary>Select up to 2 colors</summary>
                    <div class="color-grid">
                        <label><input type="checkbox" name="color" value="Red"> Red</label>
                        <label><input type="checkbox" name="color" value="Orange"> Orange</label>
                        <label><input type="checkbox" name="color" value="Yellow"> Yellow</label>
                        <label><input type="checkbox" name="color" value="Green"> Green</label>
                        <label><input type="checkbox" name="color" value="Blue"> Blue</label>
                        <label><input type="checkbox" name="color" value="Purple"> Purple</label>
                        <label><input type="checkbox" name="color" value="Pink"> Pink</label>
                        <label><input type="checkbox" name="color" value="White"> White</label>
                        <label><input type="checkbox" name="color" value="Brown"> Brown</label>
                        <label><input type="checkbox" name="color" value="Black"> Black</label>
                        <label><input type="checkbox" name="color" value="Gray"> Gray</label>
                    </div>
                </details>

                <h3 class="identifier-section-title">Location</h3>
                <details class="identifier-options">
                    <summary>Select a location</summary>
                    <label><input type="radio" name="location" value="On a tree"> On a tree</label><br>
                    <label><input type="radio" name="location" value="On the ground"> On the ground</label><br>
                    <label><input type="radio" name="location" value="On a tree root"> On a tree root</label><br>
                    <label><input type="radio" name="location" value="On a dead tree"> On a dead tree</label>
                </details>

                <h3 class="identifier-section-title">Height</h3>
                <details class="identifier-options">
                    <summary>Select a height</summary>
                    <label><input type="radio" name="height" value="Short"> Short</label><br>
                    <label><input type="radio" name="height" value="Medium"> Medium</label><br>
                    <label><input type="radio" name="height" value="Tall"> Tall</label>
                </details>

                <h3 class="identifier-section-title">Width</h3>
                <details class="identifier-options">
                    <summary>Select a width</summary>
                    <label><input type="radio" name="width" value="Thin"> Thin</label><br>
                    <label><input type="radio" name="width" value="Medium"> Medium</label><br>
                    <label><input type="radio" name="width" value="Fat"> Fat</label>
                </details>

                <h3 class="identifier-section-title">Cap shape</h3>
                <details class="identifier-options">
                    <summary>Select a cap shape</summary>
                    <label><input type="radio" name="cap shape" value="Funnel"> Funnel</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Funnel"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Funnel cap shape example"><span>Funnel picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Cone"> Cone</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Cone"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Cone cap shape example"><span>Cone picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Bell"> Bell</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Bell"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Bell cap shape example"><span>Bell picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Half-egg"> Half-egg</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Half-egg"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Half-egg cap shape example"><span>Half-egg picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Round"> Round</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Round"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Round cap shape example"><span>Round picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Flat"> Flat</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Flat"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Flat cap shape example"><span>Flat picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Central knob"> Central knob</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Central knob"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Central knob cap shape example"><span>Central knob picture</span></div></details><br>
                    <label><input type="radio" name="cap shape" value="Depression"> Depression</label> <details class="feature-help" data-feature-category="cap-shape" data-feature-value="Depression"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="Depression cap shape example"><span>Depression picture</span></div></details>
                </details>

                <h3 class="identifier-section-title">Additional characteristics</h3>
                <details class="identifier-options">
                    <summary>Gills, stem shape, and clustering</summary>
                    <p class="option-group-label">Gills</p>
                    @foreach (var value in new[] { "Adnate", "Adnexed", "Decurrent", "Emarginate", "Free", "Seceding", "Sinuate", "Subcurrent", "False" })
                    {
                        <label><input type="radio" name="gills" value="@value"> @value</label> <details class="feature-help" data-feature-category="gills" data-feature-value="@value"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="@value gills example"><span>@value picture</span></div></details><br>
                    }
                    <p class="option-group-label">Stem shape</p>
                    @foreach (var value in new[] { "Equal", "Tapering", "Club", "Bulbous", "Swollen", "Rooting", "Saccate", "Friable", "Bare", "Loose", "Felt-like", "Skirt", "Flaring", "Cortina", "Sheathing", "Double" })
                    {
                        <label><input type="radio" name="stem shape" value="@value"> @value</label> <details class="feature-help" data-feature-category="stem-shape" data-feature-value="@value"><summary>ⓘ</summary><div class="feature-placeholder"><img alt="@value stem shape example"><span>@value picture</span></div></details><br>
                    }
                    <p class="option-group-label">Clustering</p>
                    <label><input type="radio" name="clustering" value="Has many similar mushrooms nearby"> Has many similar mushrooms nearby</label><br>
                    <label><input type="radio" name="clustering" value="Has very few similar mushrooms nearby"> Has very few similar mushrooms nearby</label>
                </details>

                <h3 class="identifier-section-title">Distinctive features</h3>
                <details class="identifier-options">
                    <summary>Select distinctive features</summary>
                    <label><input type="radio" name="special features" value="Leaking red liquid"> Leaking red liquid</label><br>
                    <label><input type="radio" name="special features" value="Cap looks like a net"> Cap looks like a net</label><br>
                    <label><input type="radio" name="special features" value="Has small dots on cap"> Has small dots on cap</label>
                </details>

                <button type="submit" class="identifier-search-button">Search</button>
            </form>
        </section>

        <section class="identifier-results-card">
            <div class="identifier-result-grid">
                <img class="identifier-result-image" src="https://upload.wikimedia.org/wikipedia/commons/5/5c/Amanita_muscaria_2011_G1.JPG" alt="Mushroom identification result" />
                <div class="identifier-result-copy">
                    <h2 class="identifier-species">Species</h2>
                    <p class="identifier-scientific-name">Scientific Name</p>
                    <div class="identifier-safety-status">Poisonous</div>
                </div>
            </div>
            <div class="identifier-info">Info / Poison Control Number</div>
        </section>
    </div>
</div>

<script>
    document.querySelectorAll('.feature-help[data-feature-category]').forEach(function (featureHelp) {
        featureHelp.addEventListener('toggle', function () {
            if (!featureHelp.open) {
                return;
            }

            const category = featureHelp.dataset.featureCategory;
            const value = featureHelp.dataset.featureValue.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const image = featureHelp.querySelector('.feature-placeholder img');
            if (image) {
                image.src = '/images/identifier/' + category + '/' + value + '.jpg';
                image.onload = function () {
                    image.nextElementSibling.style.display = 'none';
                };
                image.onerror = function () {
                    image.style.display = 'none';
                };
            }
            document.querySelectorAll('.feature-help[data-feature-category="' + category + '"]').forEach(function (otherFeatureHelp) {
                if (otherFeatureHelp !== featureHelp) {
                    otherFeatureHelp.removeAttribute('open');
                }
            });
        });
    });

    document.querySelectorAll('input[name="color"]').forEach(function (colorInput) {
        colorInput.addEventListener('change', function () {
            const selectedColors = document.querySelectorAll('input[name="color"]:checked');
            const colorInputs = document.querySelectorAll('input[name="color"]');
            const limitMessage = document.getElementById('color-limit-message');
            const limitReached = selectedColors.length >= 2;

            colorInputs.forEach(function (input) {
                input.disabled = limitReached && !input.checked;
            });

            if (limitMessage) {
                limitMessage.textContent = limitReached
                    ? 'Two colors selected. Unselect a color to choose a different one.'
                    : 'Choose no more than two colors.';
            }
        });
    });
</script>


