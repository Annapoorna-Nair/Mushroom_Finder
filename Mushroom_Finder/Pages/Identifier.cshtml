@page
@model Mushroom_Finder.Pages.IdentifierModel
@{
    ViewData["Title"] = "Mushroom Identifier";
}

<div style="min-height:calc(100vh - 180px); padding:22px; background:#e9edd8; font-family:Georgia, 'Times New Roman', serif;">
    <div class="identifier-layout" style="display:grid; grid-template-columns:minmax(300px, 38%) minmax(0, 62%); gap:28px; max-width:1580px; margin:0 auto; padding:24px; background:#351f19; border:3px solid #6d32ff; border-radius:4px; box-sizing:border-box;">
        <section style="background:#fff1dc; border-radius:22px; padding:22px 18px; min-height:650px; box-sizing:border-box;">
            <form>
                <h1 style="margin:0 0 16px; font-size:2rem; font-weight:400;">Mushroom Finder</h1>
                <p style="margin:0 0 18px; font-size:1rem;">Describe what you see from a safe distance.</p>

                <h2 style="margin:10px 4px 5px; font-size:1.55rem; font-weight:400;">Color</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select up to 2 colors</summary>
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:5px; margin-top:10px;">
                        <label><input type="checkbox" name="color" value="Red"> Red</label>
                        <label><input type="checkbox" name="color" value="Orange"> Orange</label>
                        <label><input type="checkbox" name="color" value="Yellow"> Yellow</label>
                        <label><input type="checkbox" name="color" value="Green"> Green</label>
                        <label><input type="checkbox" name="color" value="Blue"> Blue</label>
                        <label><input type="checkbox" name="color" value="Purple"> Purple</label>
                        <label><input type="checkbox" name="color" value="Pink"> Pink</label>
                        <label><input type="checkbox" name="color" value="White"> White</label>
                        <label><input type="checkbox" name="color" value="Brown"> Brown</label>
                        <label><input type="checkbox" name="color" value="Black"> Black</label>
                        <label><input type="checkbox" name="color" value="Gray"> Gray</label>
                    </div>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.55rem; font-weight:400;">Location</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select a location</summary>
                    <label><input type="radio" name="location" value="On a tree"> On a tree</label><br>
                    <label><input type="radio" name="location" value="On the ground"> On the ground</label><br>
                    <label><input type="radio" name="location" value="On a tree root"> On a tree root</label><br>
                    <label><input type="radio" name="location" value="On a dead tree"> On a dead tree</label>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.55rem; font-weight:400;">Height</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select a height</summary>
                    <label><input type="radio" name="height" value="Short"> Short</label><br>
                    <label><input type="radio" name="height" value="Medium"> Medium</label><br>
                    <label><input type="radio" name="height" value="Tall"> Tall</label>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.55rem; font-weight:400;">Width</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select a width</summary>
                    <label><input type="radio" name="width" value="Thin"> Thin</label><br>
                    <label><input type="radio" name="width" value="Medium"> Medium</label><br>
                    <label><input type="radio" name="width" value="Fat"> Fat</label>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.55rem; font-weight:400;">Cap shape</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select a cap shape</summary>
                    <label><input type="radio" name="cap shape" value="Funnel"> Funnel</label><br>
                    <label><input type="radio" name="cap shape" value="Cone"> Cone</label><br>
                    <label><input type="radio" name="cap shape" value="Bell"> Bell</label><br>
                    <label><input type="radio" name="cap shape" value="Half-egg"> Half-egg</label><br>
                    <label><input type="radio" name="cap shape" value="Round"> Round</label><br>
                    <label><input type="radio" name="cap shape" value="Flat"> Flat</label><br>
                    <label><input type="radio" name="cap shape" value="Central knob"> Central knob</label><br>
                    <label><input type="radio" name="cap shape" value="Depression"> Depression</label>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.25rem; font-weight:400;">Additional characteristics</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Gills, stem shape, and clustering</summary>
                    <p style="margin-bottom:5px;">Gills</p>
                    @foreach (var value in new[] { "Adnate", "Adnexed", "Decurrent", "Emarginate", "Free", "Seceding", "Sinuate", "Subcurrent", "False" })
                    {
                        <label><input type="radio" name="gills" value="@value"> @value</label><br>
                    }
                    <p style="margin:10px 0 5px;">Stem shape</p>
                    @foreach (var value in new[] { "Equal", "Tapering", "Club", "Bulbous", "Swollen", "Rooting", "Saccate", "Friable", "Bare", "Loose", "Felt-like", "Skirt", "Flaring", "Cortina", "Sheathing", "Double" })
                    {
                        <label><input type="radio" name="stem shape" value="@value"> @value</label><br>
                    }
                    <p style="margin:10px 0 5px;">Clustering</p>
                    <label><input type="radio" name="clustering" value="Has many similar mushrooms nearby"> Has many similar mushrooms nearby</label><br>
                    <label><input type="radio" name="clustering" value="Has very few similar mushrooms nearby"> Has very few similar mushrooms nearby</label>
                </details>

                <h2 style="margin:16px 4px 5px; font-size:1.25rem; font-weight:400;">Distinctive features</h2>
                <details style="border:2px solid #171717; border-radius:20px; background:#e5e8d5; padding:10px 14px;">
                    <summary style="cursor:pointer;">Select distinctive features</summary>
                    <label><input type="radio" name="special features" value="Leaking red liquid"> Leaking red liquid</label><br>
                    <label><input type="radio" name="special features" value="Cap looks like a net"> Cap looks like a net</label><br>
                    <label><input type="radio" name="special features" value="Has small dots on cap"> Has small dots on cap</label>
                </details>

                <button type="submit" style="display:block; margin:20px auto 0; padding:12px 42px; border:0; border-radius:20px; background:#bfd0ac; color:#38251e; font:1.25rem Georgia, serif; cursor:pointer;">Search</button>
            </form>
        </section>

        <section style="background:#fff1dc; border-radius:22px; padding:10px; min-height:650px; box-sizing:border-box;">
            <div style="font-size:1rem; margin-bottom:2px;">Mushroom identification result</div>
            <div style="width:58%; margin-left:42%; text-align:center;">
                <h2 style="margin:0; font-size:3rem; font-weight:400;">Species</h2>
                <p style="margin:8px 0 28px; font-size:1.25rem; font-weight:600;">Scientific Name</p>
                <div style="width:215px; margin-left:auto; padding:12px 14px; border-radius:0 20px 20px 0; background:#ff9fa4; font-size:2rem; text-align:left; box-sizing:border-box;">Poisonous</div>
            </div>
            <div style="margin-top:108px; padding:24px 12px; font-size:2.2rem;">Info / Poison Control Number</div>
        </section>
    </div>
</div>

<style>
    @@media (max-width: 900px) {
        .identifier-layout {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 600px) {
        .identifier-layout section {
            min-height: auto !important;
        }
    }
</style>


