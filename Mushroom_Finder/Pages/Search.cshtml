@page
@{
    ViewData["Title"] = "Search";
}

<!-- Main container matching the dark brown background -->
<div style="background-color: #38241b; padding: 30px; font-family: serif; max-width: 1000px; margin: 0 auto;">

    <!-- Top beige search header area -->
    <div style="background-color: #f3e9d8; border-radius: 15px; padding: 30px; text-align: center; margin-bottom: 40px;">
        <h1 style="font-size: 32px; margin-top: 0; margin-bottom: 10px; font-weight: normal;">Search some mushrooms</h1>
        <p style="margin-top: 0; margin-bottom: 25px; font-size: 16px;">Find out edible mushrooms in every region and season</p>

        <!-- Mock Region and Season Buttons -->
        <div style="display: flex; justify-content: center; gap: 30px;">
            <div style="background-color: #6a7462; color: white; padding: 10px 60px; border-radius: 25px; font-size: 14px; font-weight: bold;">Region</div>
            <div style="background-color: #6a7462; color: white; padding: 10px 60px; border-radius: 25px; font-size: 14px; font-weight: bold;">Season</div>
        </div>
    </div>

    <!-- Mushroom Cards Container -->
    <div style="display: flex; justify-content: center; gap: 30px;">

        <!-- Lions Mane Card -->
        <div style="display: flex; flex-direction: column; align-items: center; width: 250px;">
            <div style="background-color: #f3e9d8; padding: 10px; border-radius: 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box;">
                <div style="height: 200px; background-color: #dcdcdc; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #666;">
                    [Image Placeholder]
                </div>
            </div>
            <div style="background-color: #f3e9d8; width: 100%; text-align: center; padding: 10px 0; border-radius: 8px;">
                Lions Mane
            </div>
        </div>

        <!-- Wood Blewit Card -->
        <div style="display: flex; flex-direction: column; align-items: center; width: 250px;">
            <div style="background-color: #f3e9d8; padding: 10px; border-radius: 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box;">
                <div style="height: 200px; background-color: #dcdcdc; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #666;">
                    [Image Placeholder]
                </div>
            </div>
            <div style="background-color: #f3e9d8; width: 100%; text-align: center; padding: 10px 0; border-radius: 8px;">
                Wood Blewit
            </div>
        </div>

        <!-- Amethyst Deciever Card -->
        <div style="display: flex; flex-direction: column; align-items: center; width: 250px;">
            <div style="background-color: #f3e9d8; padding: 10px; border-radius: 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box;">
                <div style="height: 200px; background-color: #dcdcdc; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #666;">
                    [Image Placeholder]
                </div>
            </div>
            <div style="background-color: #f3e9d8; width: 100%; text-align: center; padding: 10px 0; border-radius: 8px;">
                Amethyst Deciever
            </div>
        </div>

    </div>
</div>