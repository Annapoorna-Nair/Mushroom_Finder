@page
@model Mushroom_Finder.Pages.Search_csModel
@{
    ViewData["Title"] = "Search";
}
  
<div class="search-page-wrapper">
    <!-- Top Cream Search Banner -->
    <section class="search-banner" aria-labelledby="searchTitle">
        <h1 id="searchTitle" class="search-title">Search some mushrooms</h1>
        <p class="search-subtitle">Find out edible mushrooms in every region and season</p>

        <div class="search-controls">
            <label class="visually-hidden" for="mushroomSearchInput">Search mushrooms by name</label>
            <input type="text"
                   id="mushroomSearchInput"
                   class="search-bar-input"
                   placeholder="Search by mushroom name..."
                   aria-label="Search mushrooms by name"
                   aria-controls="mushroomGrid" />

            <div class="filter-row">
                <label class="visually-hidden" for="regionFilter">Filter by Region</label>
                <select id="regionFilter" class="filter-pill" aria-label="Filter by Region" aria-controls="mushroomGrid">
                    <option value="">All Regions</option>
                    <option value="north america">North America</option>
                    <option value="europe">Europe</option>
                    <option value="asia">Asia</option>
                </select>

                <label class="visually-hidden" for="seasonFilter">Filter by Season</label>
                <select id="seasonFilter" class="filter-pill" aria-label="Filter by Season" aria-controls="mushroomGrid">
                    <option value="">All Seasons</option>
                    <option value="spring">Spring</option>
                    <option value="summer">Summer</option>
                    <option value="fall">Fall</option>
                    <option value="winter">Winter</option>
                </select>
            </div>
        </div>
    </section>

    <!-- Mushroom Cards Grid -->
    <section class="mushroom-grid" id="mushroomGrid" role="region" aria-labelledby="resultsHeading">
        <h2 id="resultsHeading" class="visually-hidden">Mushroom search results</h2>
        @foreach (var mushroom in Model.Mushrooms)
        {
            <article class="mushroom-card"
                     data-name="@mushroom.Name.ToLowerInvariant()"
                     data-region="@string.Join(",", mushroom.Regions)"
                     data-season="@string.Join(",", mushroom.Seasons)">
                <div class="mushroom-img-box">
                    <img src="@Url.Content(mushroom.ImagePath)" alt="@mushroom.ImageAltText" />
                </div>
                <div class="mushroom-label-box">
                    <div class="mushroom-name">@mushroom.Name</div>
                    <p class="mushroom-meta"><strong>Region:</strong> @mushroom.RegionDisplay</p>
                    <p class="mushroom-meta"><strong>Season:</strong> @mushroom.SeasonDisplay</p>
                </div>
            </article>
        }
    </section>

    <p id="noResultsMessage"
       class="no-results-msg"
       role="status"
       aria-live="polite"
       aria-atomic="true"
       hidden>
        No mushrooms match your search and filter selection.
    </p>
</div>

<script>
    const searchInput = document.getElementById('mushroomSearchInput');
    const regionFilter = document.getElementById('regionFilter');
    const seasonFilter = document.getElementById('seasonFilter');
    const cards = document.querySelectorAll('.mushroom-card');
    const noResultsMsg = document.getElementById('noResultsMessage');

    function normalizedValues(value) {
        return value.split(',')
            .map(item => item.trim().toLowerCase())
            .filter(Boolean);
    }

    function filterMushrooms() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedRegion = regionFilter.value.toLowerCase();
        const selectedSeason = seasonFilter.value.toLowerCase();

        let visibleCount = 0;

        cards.forEach(card => {
            const name = card.dataset.name.toLowerCase();
            const regions = normalizedValues(card.dataset.region || '');
            const seasons = normalizedValues(card.dataset.season || '');

            const matchesName = name.includes(query);
            const matchesRegion = !selectedRegion || regions.includes(selectedRegion);
            const matchesSeason = !selectedSeason || seasons.includes(selectedSeason);
            const matches = matchesName && matchesRegion && matchesSeason;

            card.hidden = !matches;
            if (matches) {
                visibleCount++;
            }
        });

        noResultsMsg.hidden = visibleCount !== 0;
    }

    searchInput.addEventListener('input', filterMushrooms);
    regionFilter.addEventListener('change', filterMushrooms);
    seasonFilter.addEventListener('change', filterMushrooms);
    filterMushrooms();
</script>